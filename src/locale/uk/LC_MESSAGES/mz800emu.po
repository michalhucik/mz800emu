msgstr "Профайлер за PC"

#: src/ui-imgui/debugger/sections/dbg_profiler_pc.cpp:324
msgid ""
"Counts every executed instruction by its address: executions,\n"
"T-states (including wait states) and WAIT states."
msgstr ""
