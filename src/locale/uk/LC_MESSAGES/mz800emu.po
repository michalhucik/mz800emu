msgstr "     cgrom/vram_640/pcg_high/other)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2281
msgid "Tier 3 (Vlna 4) - temporal:"
msgstr "Tier 3 (Vlna 4) - часові:"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2283
msgid "  before(N) <ref>               - events in last N pxclk before match"
msgstr ""
"  before(N) <ref>               - події za останніх N pxclk перед shodou"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2285
msgid "  after(M) <ref>                - events in M pxclk after match"
msgstr "  after(M) <ref>                - події у M pxclk після збігу"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2287
msgid "  near(K) <ref>                 - events in window +-K around match"
msgstr "  near(K) <ref>                 - події у вікні +-K kolem збігу"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2289
msgid "    N/M/K: dec, 'k' (=1000) / 'M' (=10^6) suffix"
