msgid "Filter syntax help"
msgstr "Допомога синтаксис фільтра"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2232
msgid "Filter syntax (Tier 1):"
msgstr "Синтаксис фільтра (Tier 1):"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2235
msgid "  cat:NAME[,NAME]   - per-category (cpu_int, gdg_mode, ...)"
msgstr "  cat:Назва[,Назва] - за категорія (cpu_int, gdg_mode, ...)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2237
msgid "  sub:N[,N]         - per-subtype (uint8)"
msgstr "  sub:N[,N]         - за subtypu (uint8)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2239
msgid "  pc:HEX            - PC exact match (e.g. pc:4042)"
msgstr "  pc:Hex            - точна збіг PC (напр. pc:4042)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2241
msgid "  pc:HEX-HEX        - PC range (e.g. pc:4000-40FF)"
msgstr "  pc:Hex-Hex        - діапазон PC (напр. pc:4000-40FF)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2243
msgid "  frame:N / >N / <N - frame number"
msgstr "  frame:N / >N / <N - число frame"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2245
msgid "  cycle:N[M|k] / >N - pxclk range, M/k suffix"
msgstr "  cycle:N[M|k] / >N - діапазон pxclk, розширення M/k"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2247
msgid "  sline:N-N         - scanline range (0..311 PAL)"
msgstr "  sline:N-N         - діапазон scanline (0..311 PAL)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2249
msgid "  px:N-N            - pixel column range"
msgstr "  px:N-N            - діапазон стовпців пікселів"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2251
msgid "  payload:HEX       - payload uint32 match"
msgstr "  payload:Hex       - збіг payload uint32"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2253
msgid "  !TOKEN            - negation (e.g. !cat:gdg_video)"
msgstr "  !TOKEN            - negace (напр. !cat:gdg_video)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2255
msgid "  ( T1 or T2 )      - OR group (parens required)"
msgstr "  ( T1 or T2 )      - OR група (дужки обов'язкові)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2257
msgid "  TOKEN TOKEN       - AND (whitespace separator)"
msgstr "  TOKEN TOKEN       - AND (роздільник mezera)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2259
msgid "Tier 2 (symbol-aware):"
msgstr "Tier 2 (себе символи):"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2261
msgid "  sym:NAME / sym:PREFIX_*       - PC == addr of symbol(s)"
msgstr "  sym:Назва / sym:PREFIX_*      - PC == адреса символu(ů)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2263
msgid "  from_sym:A to_sym:B           - PC in [A.addr, B.addr]"
msgstr "  from_sym:A to_sym:B           - PC у [A.адреса, B.адреса]"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2265
msgid "Tier 3 (Vlna 4) - state-aware:"
msgstr "Tier 3 (Vlna 4) - за стану:"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2267
msgid "  if iff1:0|1                   - CPU interrupt enable"
msgstr "  if iff1:0|1                   - дозволу переривання CPU"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2269
msgid "  if im:0|1|2                   - Z80 IM mode"
msgstr "  if im:0|1|2                   - режим Z80 IM"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2271
msgid "  if reason:NAME                - BP fire reason"
msgstr "  if reason:Назва               - причина запуску BP"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2273
msgid "    (reset/ei/di/int_ack/nmi_ack/reti/retn/none)"
msgstr "    (reset/ei/di/int_ack/nmi_ack/reti/retn/none)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2275
msgid "  if banking:NAME               - memory banking summary"
msgstr "  if banking:Назва              - підсумок banking пам'яті"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2277
msgid "    (default/all_ram/rom_low_off/rom_high_off/"
