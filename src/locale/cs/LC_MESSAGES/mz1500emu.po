#: src/ui-imgui/debugger/ioview/io_window.cpp:1894
msgid ""
"Filter syntax (boolean expression):\n"
"Atoms (leaf tokens):\n"
"  port:CE       low byte match (8-bit IORQ, ignores random B reg)\n"
"  port:C0-CF    low byte range\n"
"  port16:00CE   full 16-bit match (explicit BC pattern)\n"
"  port16:CF00-CF0F  16-bit range\n"
"  pc:4042 / pc:4000-40FF          PC match / range\n"
"  value:42 / value:00-7F          value match / range\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      MMIO address match / range\n"
"  in / out      IORQ direction\n"
"  mr / mw       MMIO direction\n"
"  text          name substring (case-insensitive)\n"
"Operators (high to low precedence):\n"
"  ( )           grouping\n"
"  !             NOT (over leaf or parenthesized expression)\n"
"  space & AND   AND (AND keyword is uppercase only)\n"
"  | OR          OR  (OR keyword is uppercase only)\n"
"Examples:\n"
"  port:CE pc:4042            both must match\n"
"  port:CE | port:CF          either port\n"
"  (port:CE pc:42) | port:CF  group OR group\n"
"  !(in | out)                neither IN nor OUT"
msgstr ""
"Syntaxe filtru (booleovský výraz):\n"
"Atomy (listové tokeny):\n"
"  port:CE       shoda dolního bajtu (8bit IORQ, ignoruje náhodný B registr)\n"
"  port:C0-CF    rozsah dolního bajtu\n"
"  port16:00CE   plná 16bitová shoda (explicitní BC vzor)\n"
"  port16:CF00-CF0F  16bitový rozsah\n"
"  pc:4042 / pc:4000-40FF          shoda PC / rozsah\n"
"  value:42 / value:00-7F          shoda hodnoty / rozsah\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      shoda MMIO adresy / rozsah\n"
"  in / out      směr IORQ\n"
"  mr / mw       směr MMIO\n"
"  text          podřetězec názvu (bez ohledu na velikost písmen)\n"
"Operátory (od nejvyšší po nejnižší prioritu):\n"
"  ( )           seskupení\n"
"  !             NOT (nad listem nebo závorkovaným výrazem)\n"
"  mezera & AND  AND (klíčové slovo AND jen velkými písmeny)\n"
"  | OR          OR  (klíčové slovo OR jen velkými písmeny)\n"
"Příklady:\n"
"  port:CE pc:4042            obojí musí odpovídat\n"
"  port:CE | port:CF          kterýkoliv port\n"
"  (port:CE pc:42) | port:CF  skupina OR skupina\n"
"  !(in | out)                ani IN ani OUT"

