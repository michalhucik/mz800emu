msgstr "    Maximální hloubka zanoření = 2 úrovně"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2522
msgid "Example: cat:bp_fire,user_mark ( pc:4000-40FF or pc:5000 )"
msgstr "Příklad: cat:bp_fire,user_mark ( pc:4000-40FF or pc:5000 )"

