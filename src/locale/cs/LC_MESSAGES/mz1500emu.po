#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2458
msgid "Filter syntax (Tier 1):"
msgstr "Syntaxe filtru (Tier 1):"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2461
msgid "  cat:NAME[,NAME]   - per-category (cpu_int, gdg_mode, ...)"
msgstr "  cat:NAZEV[,NAZEV] - podle kategorie (cpu_int, gdg_mode, ...)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2463
msgid "  sub:N[,N]         - per-subtype (uint8)"
msgstr "  sub:N[,N]         - podle subtypu (uint8)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2465
msgid "  pc:HEX            - PC exact match (e.g. pc:4042)"
msgstr "  pc:HEX            - přesná shoda PC (např. pc:4042)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2467
msgid "  pc:HEX-HEX        - PC range (e.g. pc:4000-40FF)"
msgstr "  pc:HEX-HEX        - rozsah PC (např. pc:4000-40FF)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2469
msgid "  frame:N / >N / <N - frame number"
msgstr "  frame:N / >N / <N - číslo frame"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2471
msgid "  cycle:N[M|k] / >N - pxclk range, M/k suffix"
msgstr "  cycle:N[M|k] / >N - rozsah pxclk, přípona M/k"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2473
msgid "  sline:N-N         - scanline range (0..311 PAL)"
msgstr "  sline:N-N         - rozsah scanline (0..311 PAL)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2475
msgid "  px:N-N            - pixel column range"
msgstr "  px:N-N            - rozsah sloupců pixelů"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2477
msgid "  payload:HEX       - payload uint32 match"
msgstr "  payload:HEX       - shoda payload uint32"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2479
msgid "  !TOKEN            - negation (e.g. !cat:gdg_video)"
msgstr "  !TOKEN            - negace (např. !cat:gdg_video)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2481
msgid "  ( T1 or T2 )      - OR group (parens required)"
msgstr "  ( T1 or T2 )      - OR skupina (závorky povinné)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2483
msgid "  TOKEN TOKEN       - AND (whitespace separator)"
msgstr "  TOKEN TOKEN       - AND (oddělovač mezera)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2485
msgid "Tier 2 (symbol-aware):"
msgstr "Tier 2 (se symboly):"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2487
msgid "  sym:NAME / sym:PREFIX_*       - PC == addr of symbol(s)"
msgstr "  sym:NAZEV / sym:PREFIX_*      - PC == adresa symbolu(ů)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2489
msgid "  from_sym:A to_sym:B           - PC in [A.addr, B.addr]"
msgstr "  from_sym:A to_sym:B           - PC v [A.adresa, B.adresa]"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2491
msgid "Tier 3 (Vlna 4) - state-aware:"
msgstr "Tier 3 (Vlna 4) - podle stavu:"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2493
msgid "  if iff1:0|1                   - CPU interrupt enable"
msgstr "  if iff1:0|1                   - povolení přerušení CPU"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2495
msgid "  if im:0|1|2                   - Z80 IM mode"
msgstr "  if im:0|1|2                   - režim Z80 IM"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2497
msgid "  if reason:NAME                - BP fire reason"
msgstr "  if reason:NAZEV               - důvod spuštění BP"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2499
msgid "    (reset/ei/di/int_ack/nmi_ack/reti/retn/none)"
msgstr "    (reset/ei/di/int_ack/nmi_ack/reti/retn/none)"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2501
msgid "  if banking:NAME               - memory banking summary"
msgstr "  if banking:NAZEV              - souhrn banking paměti"

#: src/ui-imgui/debugger/eventview/event_viewer_window.cpp:2503
msgid "    (default/all_ram/rom_low_off/rom_high_off/"
