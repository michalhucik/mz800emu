msgid "Bytes that tell code versions apart (prefixes and opcode)."
msgstr "Bytes, die Codeversionen unterscheiden (Präfixe und Opcode)."

#: src/ui-imgui/debugger/sections/dbg_coverage.cpp:500
msgid "Epoch of the first execution (Mark starts a new epoch)."
msgstr "Epoche der ersten Ausführung (Marke beginnt eine neue Epoche)."

#: src/ui-imgui/debugger/sections/dbg_coverage.cpp:501
msgid ""
"int = first instruction of an interrupt handler, smc = the operand changed,\n"
"cmt = the CMT hack stepped in, halt = HALT, fallback = a byte was read\n"
"from memory instead of the CPU fetch, saturated = a counter overflowed,\n"
"bus = no physical cell, prefixes = a step of 64 prefixes only,\n"
"long = key longer than 4 bytes (shortened)."
msgstr ""
"int = erster Befehl einer Interrupt-Routine, smc = der Operand änderte "
"sich,\n"
"cmt = der CMT-Hack griff ein, halt = HALT, fallback = ein Byte wurde\n"
"aus dem Speicher statt aus dem CPU-Fetch gelesen, saturated = ein Zähler "
"lief über,\n"
"bus = keine physische Zelle, prefixes = ein Schritt nur aus 64 Präfixen,\n"
"long = Schlüssel länger als 4 Bytes (gekürzt)."

#: src/ui-imgui/debugger/sections/dbg_coverage.cpp:541
