#: src/ui-imgui/debugger/sections/dbg_profiler_pc.cpp:370
msgid "Nearest symbol at or below the address, + offset."
msgstr "Nächstes Symbol an oder unterhalb der Adresse, + Versatz."

#: src/ui-imgui/debugger/sections/dbg_coverage.cpp:492
msgid ""
"none = not a conditional instruction; both, taken_only, not_taken_only\n"
"= which results of the condition were seen; unobserved = none yet."
msgstr ""
"none = kein bedingter Befehl; both, taken_only, not_taken_only\n"
"= welche Ergebnisse der Bedingung auftraten; unobserved = noch keines."

#: src/ui-imgui/debugger/sections/dbg_coverage.cpp:494
msgid "How many times this code version was executed."
msgstr "Wie oft diese Codeversion ausgeführt wurde."

#: src/ui-imgui/debugger/sections/dbg_coverage.cpp:495
msgid "How many times the condition was met (jump, call, return, repeat)."
msgstr ""
"Wie oft die Bedingung erfüllt war (Sprung, Aufruf, Rücksprung, Wiederholung)."

#: src/ui-imgui/debugger/sections/dbg_coverage.cpp:496
msgid "How many times the condition was not met."
msgstr "Wie oft die Bedingung nicht erfüllt war."

#: src/ui-imgui/debugger/sections/dbg_coverage.cpp:497
msgid ""
"Physical memory cell of the first byte: ram, rom, vram, pcg, memext\n"
"and the offset; bus = no physical cell (graphic VRAM, mapped ports)."
msgstr ""
"Physische Speicherzelle des ersten Bytes: ram, rom, vram, pcg, memext\n"
"und der Offset; bus = keine physische Zelle (Grafik-VRAM, eingeblendete "
"Ports)."

