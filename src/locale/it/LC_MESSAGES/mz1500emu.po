#: src/ui-imgui/debugger/ioview/io_window.cpp:1894
msgid ""
"Filter syntax (boolean expression):\n"
"Atoms (leaf tokens):\n"
"  port:CE       low byte match (8-bit IORQ, ignores random B reg)\n"
"  port:C0-CF    low byte range\n"
"  port16:00CE   full 16-bit match (explicit BC pattern)\n"
"  port16:CF00-CF0F  16-bit range\n"
"  pc:4042 / pc:4000-40FF          PC match / range\n"
"  value:42 / value:00-7F          value match / range\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      MMIO address match / range\n"
"  in / out      IORQ direction\n"
"  mr / mw       MMIO direction\n"
"  text          name substring (case-insensitive)\n"
"Operators (high to low precedence):\n"
"  ( )           grouping\n"
"  !             NOT (over leaf or parenthesized expression)\n"
"  space & AND   AND (AND keyword is uppercase only)\n"
"  | OR          OR  (OR keyword is uppercase only)\n"
"Examples:\n"
"  port:CE pc:4042            both must match\n"
"  port:CE | port:CF          either port\n"
"  (port:CE pc:42) | port:CF  group OR group\n"
"  !(in | out)                neither IN nor OUT"
msgstr ""
"Sintassi filtro (espressione booleana):\n"
"Atomi (token foglia):\n"
"  port:CE       corrispondenza byte basso (IORQ 8 bit, ignora B reg "
"casuale)\n"
"  port:C0-CF    intervallo byte basso\n"
"  port16:00CE   corrispondenza 16 bit completa (pattern BC esplicito)\n"
"  port16:CF00-CF0F  intervallo 16 bit\n"
"  pc:4042 / pc:4000-40FF          corrispondenza PC / intervallo\n"
"  value:42 / value:00-7F          corrispondenza valore / intervallo\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      corrispondenza indirizzo MMIO / "
"intervallo\n"
"  in / out      direzione IORQ\n"
"  mr / mw       direzione MMIO\n"
"  text          sottostringa nome (case-insensitive)\n"
"Operatori (priorità da alta a bassa):\n"
"  ( )           raggruppamento\n"
"  !             NOT (su foglia o espressione tra parentesi)\n"
"  spazio & AND  AND (parola chiave AND solo maiuscola)\n"
"  | OR          OR  (parola chiave OR solo maiuscola)\n"
"Esempi:\n"
"  port:CE pc:4042            entrambi devono corrispondere\n"
"  port:CE | port:CF          una delle due porte\n"
"  (port:CE pc:42) | port:CF  gruppo OR gruppo\n"
"  !(in | out)                né IN né OUT"

