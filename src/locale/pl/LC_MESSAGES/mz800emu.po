#: src/ui-imgui/debugger/ioview/io_window.cpp:1894
msgid ""
"Filter syntax (boolean expression):\n"
"Atoms (leaf tokens):\n"
"  port:CE       low byte match (8-bit IORQ, ignores random B reg)\n"
"  port:C0-CF    low byte range\n"
"  port16:00CE   full 16-bit match (explicit BC pattern)\n"
"  port16:CF00-CF0F  16-bit range\n"
"  pc:4042 / pc:4000-40FF          PC match / range\n"
"  value:42 / value:00-7F          value match / range\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      MMIO address match / range\n"
"  in / out      IORQ direction\n"
"  mr / mw       MMIO direction\n"
"  text          name substring (case-insensitive)\n"
"Operators (high to low precedence):\n"
"  ( )           grouping\n"
"  !             NOT (over leaf or parenthesized expression)\n"
"  space & AND   AND (AND keyword is uppercase only)\n"
"  | OR          OR  (OR keyword is uppercase only)\n"
"Examples:\n"
"  port:CE pc:4042            both must match\n"
"  port:CE | port:CF          either port\n"
"  (port:CE pc:42) | port:CF  group OR group\n"
"  !(in | out)                neither IN nor OUT"
msgstr ""
"Składnia filtra (wyrażenie boolowskie):\n"
"Atomy (tokeny liści):\n"
"  port:CE       dopasowanie dolniho bajtu (8bit IORQ, ignoruje nahodny B "
"registr)\n"
"  port:C0-CF    zakres dolniho bajtu\n"
"  port16:00CE   plna 16bitova dopasowanie (explicitni BC wzór)\n"
"  port16:CF00-CF0F  16bitovy zakres\n"
"  pc:4042 / pc:4000-40FF          dopasowanie PC / zakres\n"
"  value:42 / value:00-7F          dopasowanie hodnoty / zakres\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      dopasowanie MMIO adresy / zakres\n"
"  in / out      kierunek IORQ\n"
"  mr / mw       kierunek MMIO\n"
"  text          podciąg nazvu (bez ohledu na rozmiar pismen)\n"
"Operatory (od nejvyszszi po nejniższi priorytetówu):\n"
"  ( )           seskupeni\n"
"  !             NOT (nad listem nebo zavorkovanym vyrazem)\n"
"  mezera & AND  AND (kliczove slovo AND jen velkymi pismeny)\n"
"  | OR          OR  (kliczove slovo OR jen velkymi pismeny)\n"
"Prziklady:\n"
"  port:CE pc:4042            oboji musi odpovidat\n"
"  port:CE | port:CF          kterykoliv port\n"
"  (port:CE pc:42) | port:CF  grupa OR grupa\n"
"  !(in | out)                ani IN ani OUT"

