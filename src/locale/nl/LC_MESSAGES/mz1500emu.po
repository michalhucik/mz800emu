#: src/ui-imgui/debugger/ioview/io_window.cpp:1894
msgid ""
"Filter syntax (boolean expression):\n"
"Atoms (leaf tokens):\n"
"  port:CE       low byte match (8-bit IORQ, ignores random B reg)\n"
"  port:C0-CF    low byte range\n"
"  port16:00CE   full 16-bit match (explicit BC pattern)\n"
"  port16:CF00-CF0F  16-bit range\n"
"  pc:4042 / pc:4000-40FF          PC match / range\n"
"  value:42 / value:00-7F          value match / range\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      MMIO address match / range\n"
"  in / out      IORQ direction\n"
"  mr / mw       MMIO direction\n"
"  text          name substring (case-insensitive)\n"
"Operators (high to low precedence):\n"
"  ( )           grouping\n"
"  !             NOT (over leaf or parenthesized expression)\n"
"  space & AND   AND (AND keyword is uppercase only)\n"
"  | OR          OR  (OR keyword is uppercase only)\n"
"Examples:\n"
"  port:CE pc:4042            both must match\n"
"  port:CE | port:CF          either port\n"
"  (port:CE pc:42) | port:CF  group OR group\n"
"  !(in | out)                neither IN nor OUT"
msgstr ""
"Filtersyntaxis (booleaanse expressie):\n"
"Atomen (leaf tokens):\n"
"  port:CE       lage byte match (8-bit IORQ, negeert willekeurig B reg)\n"
"  port:C0-CF    lage byte bereik\n"
"  port16:00CE   volledige 16-bit match (expliciet BC patroon)\n"
"  port16:CF00-CF0F  16-bit bereik\n"
"  pc:4042 / pc:4000-40FF          PC match / bereik\n"
"  value:42 / value:00-7F          waarde match / bereik\n"
"  frame:>100 / frame:<100 / frame:50-150\n"
"  cycle:>1000000 / cycle:1000-2000\n"
"  addr:E008 / addr:E000-E008      MMIO adres match / bereik\n"
"  in / out      IORQ-richting\n"
"  mr / mw       MMIO-richting\n"
"  text          naam substring (hoofdletter-ongevoelig)\n"
"Operators (hoog naar laag prioriteit):\n"
"  ( )           groepering\n"
"  !             NOT (over leaf of haakjes-expressie)\n"
"  spatie & AND  AND (AND keyword alleen hoofdletters)\n"
"  | OR          OR  (OR keyword alleen hoofdletters)\n"
"Voorbeelden:\n"
"  port:CE pc:4042            beide moeten matchen\n"
"  port:CE | port:CF          beide poorten\n"
"  (port:CE pc:42) | port:CF  groep OR groep\n"
"  !(in | out)                noch IN noch OUT"

